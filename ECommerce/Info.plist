<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StripePulishableKey</key>
	<string>$(STRIPE_PUBLISHABLE_KEY)</string>
	<key>ApiBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>ApiKey</key>
	<string>$(API_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ứng dụng cần vị trí của bạn để hiển thị bản đồ và đường đi</string>
	<key>NSCameraUsageDescription</key>
	<string>Ứng dụng cần truy cập camera để chụp ảnh sản phẩm và tìm kiếm bằng hình ảnh</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ứng dụng cần truy cập thư viện ảnh để chọn ảnh sản phẩm và tìm kiếm bằng hình ảnh</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ứng dụng cần quyền lưu ảnh vào thư viện ảnh của bạn</string>
</dict>
</plist>
